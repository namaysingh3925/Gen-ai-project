# ---------------------------------------------------------------------------
# RepoScribe configuration. Copy this file to `.env.local` and fill it in.
# NEVER commit real secrets - `.env*` is git-ignored (except this example file).
# ---------------------------------------------------------------------------

# --- Gemini (REQUIRED) -----------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model id. Aliases like `gemini-flash-latest` survive model renames. If the model is
# not found the app automatically falls back to GEMINI_FALLBACK_MODELS (comma separated).
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-flash-lite-latest

# --- Storage (REQUIRED on Vercel, optional locally) ------------------------
# Upstash Redis REST credentials. On Vercel: Project -> Storage -> Marketplace -> Upstash
# Redis -> Connect. That injects KV_REST_API_URL / KV_REST_API_TOKEN, which are also
# supported. Without these, local development uses a JSON file in `.data/`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- GitHub (OPTIONAL) -----------------------------------------------------
# Raises the GitHub API limit from 60 to 5000 requests/hour. Use a token that can only read
# PUBLIC data (classic: no scopes; fine-grained: "Public repositories - read only").
# Private repos are only ever read with a token the *caller* supplies per request.
GITHUB_TOKEN=

# --- Limits (OPTIONAL) -----------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
GENERATIONS_PER_DAY=20
KEY_ISSUE_PER_HOUR=10

# --- Webhooks (OPTIONAL) ---------------------------------------------------
# Allow http:// and private/localhost webhook targets. Keep `false` in production (SSRF guard).
ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# Public origin used to build absolute links (defaults to the request origin / VERCEL_URL).
PUBLIC_BASE_URL=
